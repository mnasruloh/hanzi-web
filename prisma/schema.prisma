generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model HanziEntry {
  id                        Int      @id @default(autoincrement())
  sourceId                  String   @unique @map("source_id")
  level                     Int

  simplified                String
  pinyin                    String
  pinyinNormalized          String   @map("pinyin_normalized")
  meaning                   String

  sentence                  String
  sentencePinyin            String   @map("sentence_pinyin")
  sentencePinyinNormalized  String   @map("sentence_pinyin_normalized")
  sentenceNormalized        String   @map("sentence_normalized")
  sentenceMeaning           String   @map("sentence_meaning")
  category                  String

  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@index([simplified])
  @@index([pinyinNormalized])
  @@index([level])
  @@index([category])
  @@map("hanzi_entries")
}